+    /// The store state the preferences model tracks: the baseline the store last adopted, whether an observed change has latched it, the
+    /// store's file version, and the missing sidecar's source and value. It is a plain value that takes the external state as arguments,
+    /// so no helper captures the test's mutable locals.
+    private struct PreferencesModel {
+        var adopted = false
+        var latched = false
+        var baseline: Data?
+        var version: UInt64 = 0
+        /// The runtime variant the store last adopted as the missing sidecar's source, and the showMenuBarIcon it last adopted.
+        var sidecarSource: Int?
+        var adoptedShows = true
+
+        /// Adopts a load of the external state, and returns whether it was a reload where only the missing sidecar's value moved.
+        mutating func adoptLoad(external: Data?, externalShows: Bool?, runtimeVariant: Int?) -> Bool {
+            // The showMenuBarIcon a load adopts: the sidecar's own value, or the runtime file's legacy value when the sidecar is missing.
+            let loadedShows = external == nil ? runtimeVariant != 1 : externalShows != false
+            let valueMoved = external == nil && adoptedShows != loadedShows
+            let onlyValueMoved = adopted && !latched && baseline == external && valueMoved
+            if !adopted || latched || baseline != external || valueMoved { version += 1 }
+            baseline = external
+            sidecarSource = runtimeVariant
+            adoptedShows = loadedShows
+            adopted = true
+            latched = false
+            return onlyValueMoved
+        }
+    }
